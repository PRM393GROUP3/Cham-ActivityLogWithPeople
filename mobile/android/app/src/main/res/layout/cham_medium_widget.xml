<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4×2 "Bạn bè": tiêu đề + nút +, danh sách cuộn bạn bè có hoạt động hôm nay -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/medium_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/medium_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bạn bè"
            android:textColor="#2C2523"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/medium_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="5 người hôm nay"
            android:textColor="#857469"
            android:textSize="11sp" />

        <FrameLayout
            android:id="@+id/medium_plus_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_plus_circle"
            android:contentDescription="Chấm hoạt động">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/medium_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@drawable/widget_list_divider"
            android:dividerHeight="1dp"
            android:paddingBottom="14dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/medium_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👋"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/medium_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxWidth="230dp"
                android:text="Mở Chấm để xem bạn bè đang làm gì"
                android:textColor="#857469"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/medium_empty_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/widget_cta_bg"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="Mở Chấm"
                android:textColor="#2C2523"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mép dưới mờ dần để báo danh sách còn nữa -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_gravity="bottom"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_list_fade" />
    </FrameLayout>
</LinearLayout>
