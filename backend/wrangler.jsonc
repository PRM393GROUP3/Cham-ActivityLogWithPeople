{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cham-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	// Local dev (`wrangler dev`) emulates every binding below with Miniflare,
	// persisted in .wrangler/state — no Cloudflare account needed.
	// `npm run deploy` uses the real resources whose ids are below.
	// Don't add `"remote": true` — that makes `wrangler dev` read/write production data.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cham-db",
			"database_id": "ee2a8f57-cded-4392-8e07-ce512d6763a2",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			// Uploaded avatar images, served through GET /api/avatars/* (the bucket stays private).
			"binding": "AVATARS",
			"bucket_name": "cham-avatars"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				// One instance per user (idFromName(userId)) holding their open WebSockets.
				"name": "USER_ROOM",
				"class_name": "UserRoom"
			}
		]
	},
	// Free plan only supports SQLite-backed Durable Objects.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"TodoRoom"
			]
		},
		{
			"tag": "v2",
			"renamed_classes": [
				{
					"from": "TodoRoom",
					"to": "UserRoom"
				}
			]
		}
	],
	"vars": {
		"CORS_ORIGIN": "*"
	}
}